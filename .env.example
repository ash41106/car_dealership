# Copy to .env (or set in your host's environment). Never commit real secrets.
NODE_ENV=production
PORT=3000
BASE_URL=https://www.example.com
DB_PATH=./data/app.db
SESSION_SECRET=change-me-long-random
TRUST_PROXY=1

# --- Customer OTP / messaging ---------------------------------------------
# In production OTP login is FAIL-CLOSED: without a real provider POST /api/customer/otp/request returns 503
# and no dev_otp / fixed OTP is ever available. OTP_MODE=mock is ignored when NODE_ENV=production.
MESSAGING_PROVIDER=http
MESSAGING_URL=https://gateway.example.com/v1/send
MESSAGING_TOKEN=secret-token
# MESSAGING_AUTH_HEADER=Authorization      # e.g. authkey (MSG91) - default Authorization
# MESSAGING_AUTH_SCHEME=Bearer             # '' to send the raw token
# MESSAGING_HEADERS={"x-extra":"value"}
SENDER_ID=COMPAM
DLT_ENTITY_ID=1101000000000000000
DLT_TEMPLATE_IDS={"otp":"1107000000000000001","ack_lead":"1107000000000000002","test_drive_confirm":"1107000000000000003","service_confirm":"1107000000000000004"}
# Optional: map to a gateway's own JSON schema with {{to}} {{to10}} {{message}} {{sender}} {{template}} {{template_id}} {{entity_id}} {{channel}} {{lang}} {{otp}}
# MESSAGING_BODY_TEMPLATE={"template_id":"{{template_id}}","recipients":[{"mobiles":"{{to}}","otp":"{{otp}}"}]}
# MESSAGING_TIMEOUT_MS=8000
OTP_RATE_LIMIT=3

# --- Optional -------------------------------------------------------------
# ANTHROPIC_API_KEY=
# RATE_LIMIT_PUBLIC=20
# AUTO_SEED=0
